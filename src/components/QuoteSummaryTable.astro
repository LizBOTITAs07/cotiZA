---
import { SERVICE_CATALOG } from '../lib/catalog.js';
import IconTrash from './icons/IconTrash.astro';

const currency = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });
---

<section class="card summary-card" aria-labelledby="summary-heading" id="resumen">
  <h2 id="summary-heading">Tu cotización</h2>
  <p>Desglose de los servicios seleccionados.</p>
  <div class="table-wrap">
    <table class="quote-table">
      <caption class="sr-only">Conceptos, cantidades y precios de la cotización</caption>
      <thead>
        <tr>
          <th scope="col">Cant.</th>
          <th scope="col">Concepto</th>
          <th scope="col">Precio</th>
          <th scope="col">Importe</th>
          <th scope="col"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        {SERVICE_CATALOG.map((service) => {
          const isFixed = service.fixedCharge === true;
          return (
            <tr
              data-summary-item={service.id}
              data-fixed-charge={isFixed ? 'true' : undefined}
              hidden
            >
              <td data-line-quantity>0</td>
              <td>{service.concept}</td>
              <td>{currency.format(service.unitPrice)}</td>
              <td data-line-amount>{currency.format(0)}</td>
              <td>
                {!isFixed && (
                  <button
                    class="remove-item"
                    type="button"
                    data-remove-item={service.id}
                    aria-label={`Quitar ${service.concept} de la cotización`}
                    title="Quitar de la cotización"
                  >
                    <IconTrash />
                  </button>
                )}
              </td>
            </tr>
          );
        })}
        <tr data-empty-row hidden>
          <td class="table-empty" colspan="5">Agrega servicios para ver el desglose.</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="form-status" id="form-status" role="status" aria-live="polite">
    Completa los datos del evento y las cantidades.
  </p>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
</style>
