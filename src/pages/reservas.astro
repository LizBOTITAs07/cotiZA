---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModalContainer from '../components/ModalContainer.astro';
import '../styles/reservations.css';
---

<BaseLayout
  title="Reservas | MiEvento"
  description="Consulta, filtra y administra las reservas guardadas en este navegador."
>
  <main class="page-main reservations-page">
    <header class="intro">
      <div>
        <p class="eyebrow">MiEvento Reservas</p>
        <h1>Reservas guardadas</h1>
        <p class="intro-copy">
          Este listado y su inventario se guardan solo en este navegador. No se sincronizan con otros dispositivos.
        </p>
      </div>
      <a class="button button--primary" href="/nueva-reserva">Nueva reserva</a>
    </header>

    <section class="card reservations-card" aria-labelledby="reservations-heading">
      <div class="reservation-toolbar">
        <div class="search-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="search-name" placeholder="Buscar por cliente..." class="field-control" />
        </div>
        <div class="filters-group">
          <span class="filter-label">Filtrar:</span>
          <div class="field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-field"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <input class="field-control" id="filter-date" type="date" />
          </div>
          <div class="field">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="icon-field"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            <select class="field-control" id="filter-status">
              <option value="">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="confirmada">Confirmada</option>
              <option value="liquidada">Liquidada</option>
              <option value="cancelada">Cancelada</option>
            </select>
          </div>
          <button class="button button--secondary" type="button" id="clear-filter">Limpiar</button>
        </div>
      </div>
      <p class="form-status" role="status" aria-live="polite" id="reservations-message"></p>
      <div class="table-wrap">
        <table class="reservations-table">
          <caption class="sr-only">Reservas guardadas en este navegador</caption>
          <thead>
            <tr>
              <th scope="col">Folio</th>
              <th scope="col">Cliente</th>
              <th scope="col">Evento</th>
              <th scope="col">Total</th>
              <th scope="col">Anticipo</th>
              <th scope="col">Saldo</th>
              <th scope="col">Estado</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody id="reservations-body"></tbody>
        </table>
      </div>
    </section>
  </main>
  <ModalContainer />
</BaseLayout>

<script>
  import {
    cancelReservationInStorage,
    loadReservations,
    recordDepositInStorage,
    recordPaymentInStorage,
    updateReservationInStorage,
    RESERVATIONS_STORAGE_KEY,
  } from '../lib/reservationsStore.js';

  const dateFilter = document.querySelector('#filter-date');
  const statusFilter = document.querySelector('#filter-status');
  const nameSearch = document.querySelector('#search-name');
  const reservationsBody = document.querySelector('#reservations-body');
  const message = document.querySelector('#reservations-message');
  const currency = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });
  const statusLabels = { 
    pendiente: 'Pendiente', 
    confirmada: 'Confirmada', 
    liquidada: 'Liquidada', 
    cancelada: 'Cancelada' 
  };

  const modal = document.querySelector('#app-modal');

  function openModal(title, body) {
    modal.querySelector('[data-modal-title]').textContent = title;
    const host = modal.querySelector('[data-modal-body]');
    host.replaceChildren();
    if (typeof body === 'string') {
      const p = document.createElement('p');
      p.textContent = body;
      host.append(p);
    } else {
      host.append(body);
    }
    modal.showModal();
  }

  modal.querySelector('[data-modal-close]').addEventListener('click', () => modal.close());

  function addTextCell(row, value) {
    const cell = document.createElement('td');
    cell.textContent = value;
    row.append(cell);
    return cell;
  }

  function renderReservations() {
    try {
      const filterDate = dateFilter.value;
      const filterStatus = statusFilter.value;
      const searchTerm = nameSearch.value.toLowerCase();

      const reservations = loadReservations()
        .filter((res) => {
          const matchDate = !filterDate || res.fecha === filterDate;
          const matchStatus = !filterStatus || res.estado === filterStatus;
          const matchName = !searchTerm || res.cliente.toLowerCase().includes(searchTerm);
          return matchDate && matchStatus && matchName;
        })
        .sort((left, right) => left.fecha.localeCompare(right.fecha) || right.creadoEn.localeCompare(left.creadoEn));
      reservationsBody.replaceChildren();

      for (const reservation of reservations) {
        const row = document.createElement('tr');
        addTextCell(row, reservation.id.slice(0, 8).toUpperCase());
        addTextCell(row, reservation.cliente);
        addTextCell(row, reservation.fecha);
        addTextCell(row, currency.format(reservation.total));
        addTextCell(row, currency.format(reservation.anticipo));
        addTextCell(row, currency.format(reservation.saldo));
        const statusCell = addTextCell(row, statusLabels[reservation.estado]);
        statusCell.dataset.status = reservation.estado;

        const actions = document.createElement('td');
        actions.className = 'reservation-actions';
        const receiptLink = document.createElement('a');
        receiptLink.className = 'button button--quiet';
        receiptLink.href = `/cotizacion/${encodeURIComponent(reservation.id)}`;
        receiptLink.textContent = 'Comprobante';
        actions.append(receiptLink);

        if (reservation.estado === 'pendiente') {
          const depositButton = document.createElement('button');
          depositButton.className = 'button button--secondary';
          depositButton.type = 'button';
          depositButton.textContent = 'Registrar anticipo';
          depositButton.dataset.deposit = reservation.id;
          actions.append(depositButton);
        }
        if (reservation.estado === 'confirmada') {
          const paymentButton = document.createElement('button');
          paymentButton.className = 'button button--secondary';
          paymentButton.type = 'button';
          paymentButton.textContent = 'Registrar abono';
          paymentButton.dataset.payment = reservation.id;
          actions.append(paymentButton);
        }
        if (reservation.estado !== 'cancelada' && reservation.estado !== 'liquidada') {
          const editButton = document.createElement('button');
          editButton.className = 'button button--quiet';
          editButton.type = 'button';
          editButton.textContent = 'Editar';
          editButton.dataset.edit = reservation.id;
          actions.append(editButton);
        }
        if (reservation.estado !== 'cancelada') {
          const cancelButton = document.createElement('button');
          cancelButton.className = 'button button--secondary';
          cancelButton.type = 'button';
          cancelButton.textContent = 'Cancelar';
          cancelButton.dataset.cancel = reservation.id;
          actions.append(cancelButton);
        }
        row.append(actions);
        reservationsBody.append(row);
      }

      message.textContent = reservations.length
        ? `${reservations.length} reserva${reservations.length === 1 ? '' : 's'} en este navegador.`
        : 'No hay reservas para mostrar.';
      message.dataset.tone = '';
    } catch (error) {
      console.error('[reservas] No se pudieron leer las reservas locales.', {
        name: error instanceof Error ? error.name : 'UnknownError',
      });
      reservationsBody.replaceChildren();
      message.textContent = error instanceof Error ? error.message : 'No se pudieron leer las reservas locales.';
      message.dataset.tone = 'error';
    }
  }

  document.querySelector('#clear-filter').addEventListener('click', () => {
    dateFilter.value = '';
    statusFilter.value = '';
    nameSearch.value = '';
    renderReservations();
  });
  dateFilter.addEventListener('change', renderReservations);
  statusFilter.addEventListener('change', renderReservations);
  nameSearch.addEventListener('input', renderReservations);

  reservationsBody.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) {
      return;
    }
    const depositButton = event.target.closest('[data-deposit]');
    if (depositButton instanceof HTMLButtonElement) {
      const reservation = loadReservations().find((item) => item.id === depositButton.dataset.deposit);
      if (!reservation) {
        renderReservations();
        return;
      }
      const minimum = (Math.ceil(reservation.total * 100 * 0.3) / 100).toFixed(2);
      const form = document.createElement('form');
      form.innerHTML = `<label>Monto del anticipo (mínimo ${minimum} MXN)<input id="deposit-modal-input" class="field-control" type="number" min="${minimum}" max="${reservation.total}" step="0.01" required></label><button class="button button--primary" type="submit">Registrar</button>`;
      openModal('Registrar anticipo', form);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          await recordDepositInStorage(reservation.id, form.querySelector('#deposit-modal-input').value);
          modal.close();
          openModal('Anticipo registrado', 'La reserva quedó confirmada.');
          renderReservations();
        } catch (error) {
          openModal('Datos inválidos', error instanceof Error ? error.message : 'No se pudo registrar el anticipo.');
        }
      });
      return;
    }

    const paymentButton = event.target.closest('[data-payment]');
    if (paymentButton instanceof HTMLButtonElement) {
      const reservation = loadReservations().find((item) => item.id === paymentButton.dataset.payment);
      if (!reservation) return;
      const form = document.createElement('form');
      form.innerHTML = `<label>Monto del abono<input id="payment-modal-input" class="field-control" type="number" min="0.01" max="${reservation.saldo}" step="0.01" required></label><label>Método<select id="payment-modal-method" class="field-control"><option>Efectivo</option><option>Transferencia</option></select></label><button class="button button--primary" type="submit">Registrar abono</button>`;
      openModal('Registrar abono', form);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          await recordPaymentInStorage(
            reservation.id,
            form.querySelector('#payment-modal-input').value,
            form.querySelector('#payment-modal-method').value,
          );
          modal.close();
          openModal('Abono registrado', 'El saldo de la reserva fue actualizado.');
          renderReservations();
        } catch (error) {
          openModal('Pago inválido', error instanceof Error ? error.message : 'No se pudo registrar el abono.');
        }
      });
      return;
    }

    const editButton = event.target.closest('[data-edit]');
    if (editButton instanceof HTMLButtonElement) {
      const reservation = loadReservations().find((item) => item.id === editButton.dataset.edit);
      if (!reservation) return;
      const form = document.createElement('form');
      form.innerHTML = `<div class="field-grid"><label>Nombre<input id="edit-name" class="field-control" value="${reservation.cliente.replace(/"/g, '&quot;')}" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ ]+" required></label><label>Fecha<input id="edit-date" class="field-control" type="date" value="${reservation.fecha}" required></label><label>Sillas<input id="edit-chairs" class="field-control" type="number" min="0" max="120" value="${reservation.sillas}" required></label><label>Mesas<input id="edit-tables" class="field-control" type="number" min="0" max="12" value="${reservation.mesas}" required></label><label>Decoración<input id="edit-decoration" class="field-control" type="number" min="0" max="1" value="${reservation.decoracion}" required></label><label>Entrega<input id="edit-delivery" type="checkbox" ${reservation.entrega ? 'checked' : ''}></label></div><button class="button button--primary" type="submit">Guardar cambios</button>`;
      openModal(`Editar reserva ${reservation.id.slice(0, 8).toUpperCase()}`, form);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
          await updateReservationInStorage(reservation.id, {
            clientName: form.querySelector('#edit-name').value,
            eventDate: form.querySelector('#edit-date').value,
            quantities: {
              sillas: Number(form.querySelector('#edit-chairs').value),
              mesas: Number(form.querySelector('#edit-tables').value),
              decoracion: Number(form.querySelector('#edit-decoration').value),
              entrega: form.querySelector('#edit-delivery').checked,
            },
          });
          modal.close();
          openModal('Reserva actualizada', 'Los datos y los totales fueron recalculados.');
          renderReservations();
        } catch (error) {
          openModal('El saldo / stock no es válido', error instanceof Error ? error.message : 'El saldo / stock no es válido para editar esta reserva');
        }
      });
      return;
    }

    const cancelButton = event.target.closest('[data-cancel]');
    if (cancelButton instanceof HTMLButtonElement) {
      const id = cancelButton.dataset.cancel;
      const form = document.createElement('div');
      form.innerHTML = '<p>¿Cancelar esta reserva? Se conservará como registro histórico y su inventario quedará disponible.</p><button class="button button--primary" type="button" data-confirm-cancel>Confirmar cancelación</button>';
      openModal('Cancelar reserva', form);
      form.querySelector('[data-confirm-cancel]').addEventListener('click', async () => {
        try {
          await cancelReservationInStorage(id);
          modal.close();
          openModal('Reserva cancelada', 'El inventario de esa fecha quedó disponible.');
          renderReservations();
        } catch (error) {
          openModal('Cancelación no disponible', error instanceof Error ? error.message : 'No se pudo cancelar la reserva.');
        }
      });
    }
  });

  window.addEventListener('storage', (event) => {
    if (event.key === RESERVATIONS_STORAGE_KEY) {
      renderReservations();
    }
  });

  renderReservations();
</script>
