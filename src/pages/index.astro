---
import BaseLayout from '../layouts/BaseLayout.astro';
import IconCalendar from '../components/icons/IconCalendar.astro';
import IconPlus from '../components/icons/IconPlus.astro';

// Reusing IconTruck for 'Pagos' as a placeholder since wallet icon is not provided
import IconTruck from '../components/icons/IconTruck.astro'; 
---

<BaseLayout
  title="Inicio | Cotiza Vibe"
  description="Sistema de gestión de cotizaciones y reservas para Vibe Pachuca."
>
  <main class="home-hub">
    <section class="welcome-header">
      <h1>Bienvenido</h1>
      <p>Tu eliges como empezar</p>
    </section>

    <nav class="hub-grid" aria-label="Navegación principal">
      <a href="/reservas" class="hub-card">
        <div class="hub-icon"><IconCalendar size={48} /></div>
        <span>Reservas</span>
      </a>
      <a href="/nueva-reserva" class="hub-card">
        <div class="hub-icon"><IconPlus size={48} /></div>
        <span>Nueva</span>
      </a>
      <a href="/pagos" class="hub-card">
        <div class="hub-icon"><IconTruck size={48} /></div>
        <span>Pagos</span>
      </a>
    </nav>
  </main>
</BaseLayout>

<style>
  .home-hub {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
  }
  .welcome-header h1 {
    font-size: 3rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .welcome-header p {
    font-size: 1.25rem;
    color: #64748b;
    margin-bottom: 3rem;
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 800px;
  }
  .hub-card {
    background: var(--color-primary);
    color: white;
    padding: 2.5rem 1.5rem;
    border-radius: 1rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transition: transform 0.2s, background-color 0.2s;
    border-bottom: 6px solid var(--color-accent);
  }
  .hub-card:hover {
    transform: translateY(-5px);
    background-color: #1e3a8a;
  }
  .hub-card span {
    font-weight: bold;
    font-size: 1.25rem;
  }
  .hub-icon {
    color: var(--color-accent);
  }
</style>
