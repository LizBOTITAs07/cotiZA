---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientForm from '../components/ClientForm.astro';
import QuoteSummaryTable from '../components/QuoteSummaryTable.astro';
import ServiceSelector from '../components/ServiceSelector.astro';
import TotalsPanel from '../components/TotalsPanel.astro';
import { SERVICE_CATALOG } from '../lib/catalog.js';
import IconChair from '../components/icons/IconChair.astro';
---

<BaseLayout
  title="Nueva cotización | Vibe Pachuca"
  description="Arma y calcula en segundos una cotización de mobiliario y servicios para tu evento."
>
  <main class="page-main" id="cotizador">
    <header class="intro">
      <div>
        <p class="eyebrow">Cotizaciones para eventos</p>
        <h1>Cotiza más rápido</h1>
        <p class="intro-copy">
          Prepara una reserva para el evento. El subtotal, el descuento y el total
          se actualizan al instante.
        </p>
      </div>
    </header>

    <form class="quote-form" id="quote-form" novalidate>
      <div class="content-grid">
        <div class="main-column">
          <ClientForm />
          <section class="card" aria-labelledby="services-heading">
            <header class="section-heading">
              <span class="section-icon" aria-hidden="true">
                <IconChair />
              </span>
              <div>
                <h2 id="services-heading">Servicios para tu evento</h2>
                <p>Hay 120 sillas y 12 mesas por fecha; la decoración es opcional.</p>
              </div>
            </header>

            <div class="service-list">
              {SERVICE_CATALOG.map((service) => (
                <ServiceSelector service={service} />
              ))}
            </div>
            <p class="inventory-status" id="inventory-status" role="status" aria-live="polite">
              Elige una fecha para consultar el inventario local de ese día.
            </p>
          </section>
          <QuoteSummaryTable />
        </div>

        <aside class="quote-side" aria-label="Resumen de la cotización">
          <TotalsPanel />
        </aside>
      </div>
    </form>
  </main>
</BaseLayout>

<script>
  import '../scripts/quote-app.js';
</script>
